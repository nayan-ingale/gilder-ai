# Copy to .env.local (git-ignored).

# Server-only: the Next.js server proxies /api/* to this address. Never prefixed with NEXT_PUBLIC_,
# so it is never sent to the browser.
GATEWAY_URL=http://localhost:8000

# Google sign-in: your Firebase project's web app config (Project settings > General > Your apps
# > Web app). These are public: Next.js sends NEXT_PUBLIC_* values to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Uploads: your bucket's address, https://<S3_BUCKET>.s3.<AWS_REGION>.amazonaws.com (the values in
# the agent's .env). Read when the app is built, for the security policy: the browser may send
# uploads only there. Without it, uploads and file questions can't work.
S3_BUCKET_ORIGIN=

# Payments: the Razorpay test key ID (rzp_test_…), the same value as RAZORPAY_KEY_ID in billing.
# Public too: the checkout shows it in the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
