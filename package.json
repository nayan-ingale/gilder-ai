{
  "name": "gilder-ai",
  "version": "0.0.0",
  "private": true,
  "description": "GilderAi: a multi-agent AI workspace",
  "license": "MIT",
  "author": "Nayan Ingale",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present --filter '!@gilder/docs-explorer' dev",
    "docs:dev": "pnpm --filter @gilder/docs-explorer dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint . && pnpm --filter @gilder/frontend --filter @gilder/docs-explorer lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:env": "for dir in backend/gateway backend/services/*; do [ -f \"$dir/.env\" ] || cp \"$dir/.env.example\" \"$dir/.env\"; done; [ -f frontend/.env.local ] || cp frontend/.env.example frontend/.env.local; echo 'env files ready (existing ones were kept)'",
    "infra:up": "docker compose -f backend/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f backend/docker-compose.yml down",
    "infra:ps": "docker compose -f backend/docker-compose.yml ps",
    "infra:logs": "docker compose -f backend/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
