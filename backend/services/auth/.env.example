# Copy to .env with `pnpm setup:env` (git-ignored). Some settings are for features that aren't
# built yet.
PORT=8001
LOG_LEVEL=info
MONGODB_URI=mongodb://localhost:27018/gilder_auth?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6380

# Checks the internal tokens from the gateway. Written by `pnpm setup:keys`.
INTERNAL_PUBLIC_KEY=

# Sign-in with just an email, for local development and tests. Auth refuses to start in
# production with this on.
AUTH_DEV_LOGIN=false

# Google sign-in: a service account of your own Firebase project (Project settings > Service
# accounts). Set all three or none; production requires them. Paste the private key as it is
# in the JSON file, \n escapes included; double quotes are optional.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
