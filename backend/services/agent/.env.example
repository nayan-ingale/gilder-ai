# Copy to .env with `pnpm setup:env` (git-ignored). Some settings are for features that aren't
# built yet.
PORT=8003
LOG_LEVEL=info
MONGODB_URI=mongodb://localhost:27018/gilder_agent?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6380
QDRANT_URL=http://localhost:6335
CHAT_SERVICE_URL=http://localhost:8002
BILLING_SERVICE_URL=http://localhost:8004

# Checks the internal tokens from the gateway. Written by `pnpm setup:keys`.
INTERNAL_PUBLIC_KEY=
# The agent's own key, for saving messages in chat and charging credits in billing. Written by
# `pnpm setup:keys`.
SERVICE_PRIVATE_KEY=

# AI providers. Groq (console.groq.com > API Keys): chat, routing and writing.
GROQ_API_KEY=
# OpenRouter (openrouter.ai > Keys): the code agent. Set a credit limit on the key.
OPENROUTER_API_KEY=
# Google Gemini (aistudio.google.com > Get API key): PDF embeddings and image questions.
GEMINI_API_KEY=
# Tavily (app.tavily.com): web search.
TAVILY_API_KEY=

# File storage: an S3 bucket of your own, and an IAM user that can use only that bucket.
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
