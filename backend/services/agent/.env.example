# Copy to .env with `pnpm setup:env` (git-ignored). Some settings are for features that aren't
# built yet.
PORT=8003
LOG_LEVEL=info
MONGODB_URI=mongodb://localhost:27018/gilder_agent?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6380
QDRANT_URL=http://localhost:6335
CHAT_SERVICE_URL=http://localhost:8002
BILLING_SERVICE_URL=http://localhost:8004

# Checks the internal tokens from the gateway. Written by `pnpm setup:keys`.
INTERNAL_PUBLIC_KEY=
