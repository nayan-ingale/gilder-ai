# Copy to .env with `pnpm setup:env` (git-ignored). Some settings are for features that aren't
# built yet.
PORT=8004
LOG_LEVEL=info
MONGODB_URI=mongodb://localhost:27018/gilder_billing?replicaSet=rs0&directConnection=true

# Check the internal tokens from the gateway, auth and the agent. Written by `pnpm setup:keys`.
INTERNAL_PUBLIC_KEY=
AUTH_PUBLIC_KEY=
AGENT_PUBLIC_KEY=

# Payments: Razorpay in test mode (dashboard.razorpay.com > Test mode > Settings > API Keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret the payment webhook is signed with. Locally, any long random string works.
RAZORPAY_WEBHOOK_SECRET=
