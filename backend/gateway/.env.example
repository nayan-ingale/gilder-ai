# Copy to .env with `pnpm setup:env` (git-ignored). Some settings are for features that aren't
# built yet.
PORT=8000
LOG_LEVEL=info
# Where the browser pages come from (one origin, or several separated by commas). Requests that
# change something must carry one of these as their Origin.
FRONTEND_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6380
AUTH_SERVICE_URL=http://localhost:8001
CHAT_SERVICE_URL=http://localhost:8002
AGENT_SERVICE_URL=http://localhost:8003
BILLING_SERVICE_URL=http://localhost:8004

# Signs the internal tokens the gateway sends to the services. Written by `pnpm setup:keys`;
# never share it.
INTERNAL_PRIVATE_KEY=

# How many proxies in front of the gateway to trust for the client's IP address: 1 locally (the
# Next.js server). Optional.
TRUST_PROXY_HOPS=1
