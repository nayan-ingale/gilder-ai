{
  "name": "@gilder/docs-explorer",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive map of the GilderAi codebase: architecture, request flows and the real source code",
  "type": "module",
  "scripts": {
    "index:source": "node scripts/index-source.ts",
    "verify": "node scripts/index-source.ts && node scripts/verify-docs.ts",
    "dev": "node scripts/index-source.ts && vite",
    "build": "node scripts/index-source.ts && node scripts/verify-docs.ts && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/index-source.ts && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@xyflow/react": "12.12.0",
    "minisearch": "7.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.5.1",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  }
}
